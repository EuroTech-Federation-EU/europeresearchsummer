---
import { Image } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import { PILLARS, STATS } from "../../data/program";
import studentsWorking from "../../assets/photos/students-working.jpg";

const STAGGER_STEP_MS = 70;
---

<section id="about" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div data-reveal>
      <SectionHead
        eyebrowText="About the programme"
        title="Real research, taken seriously."
        lead="We find Europe's strongest student AI talent early, connect it, and keep it working in Europe. A former President of the European Research Council advises the programme."
      />
    </div>
    <dl
      data-reveal
      class="grid grid-cols-2 border-y border-line md:grid-cols-4"
    >
      {
        STATS.map(([stat, label], index) => (
          <div
            class={`py-6 ${index > 0 ? "border-l border-line pl-6 max-md:odd:border-l-0 max-md:odd:pl-0" : ""}`}
          >
            <dt class="font-mono text-3xl font-semibold text-body tabular-nums md:text-4xl">
              {stat}
            </dt>
            <dd class="mt-1.5 font-mono text-[10px] tracking-[0.18em] text-muted uppercase">
              {label}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-14 grid gap-y-10 md:grid-cols-3">
      {
        PILLARS.map((pillar, index) => (
          <div
            data-reveal
            style={`--reveal-delay: ${index * STAGGER_STEP_MS}ms`}
            class={`md:px-8 ${index > 0 ? "md:border-l md:border-line" : "md:pl-0"}`}
          >
            <p class="font-mono text-xs tracking-[0.2em] text-cyan">
              0{index + 1}
            </p>
            <h3 class="mt-4 mb-3 text-xl font-semibold tracking-tight">
              {pillar.title}
            </h3>
            <p class="text-muted">{pillar.text}</p>
          </div>
        ))
      }
    </div>
    <figure data-reveal class="mt-14">
      <div class="overflow-hidden rounded-xs border border-line">
        <Image
          src={studentsWorking}
          alt="Students working on laptops around a shared table"
          widths={[800, 1600]}
          sizes="(max-width: 1152px) 100vw, 1104px"
          class="h-64 w-full object-cover saturate-[0.8] md:h-80"
        />
      </div>
      <figcaption
        class="mt-3 font-mono text-[10px] tracking-[0.18em] text-muted/80 uppercase"
      >
        Original research, written where the participants study
      </figcaption>
    </figure>
  </div>
</section>
