---
import { Image } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import { PILLARS, STATS } from "../../data/program";
import { bodyCopy, microLabel } from "../../lib/styles";
import studentsWorking from "../../assets/photos/students-working.jpg";

const STAGGER_STEP_MS = 70;
---

<section id="about" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div data-reveal>
      <SectionHead
        eyebrowText="About the programme"
        title="Real research, taken seriously."
        lead="We find Europe's strongest student AI talent early, connect it, and keep it working in Europe. A former President of the European Research Council advises the programme."
      />
    </div>
    <dl
      data-reveal
      class="grid grid-cols-2 border-y border-line md:grid-cols-4"
    >
      {
        STATS.map(([stat, label], index) => (
          <div
            class={`py-6 ${index > 0 ? "border-l border-line pl-6 max-md:odd:border-l-0 max-md:odd:pl-0" : ""}`}
          >
            <dt class="font-mono text-title font-semibold text-body tabular-nums md:text-headline">
              {stat}
            </dt>
            <dd class={`mt-2 ${microLabel}`}>
              {label}
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="mt-14 grid gap-y-10 md:grid-cols-3">
      {
        PILLARS.map((pillar, index) => (
          <div
            data-reveal
            style={`--reveal-delay: ${index * STAGGER_STEP_MS}ms`}
            class={`md:px-8 ${index > 0 ? "md:border-l md:border-line" : "md:pl-0"}`}
          >
            <p class="font-mono text-label tracking-label text-cyan">
              0{index + 1}
            </p>
            <h3 class="mt-4 mb-3.5 text-subtitle font-semibold tracking-heading text-body">
              {pillar.title}
            </h3>
            <p class={bodyCopy}>{pillar.text}</p>
          </div>
        ))
      }
    </div>
  </div>
  <figure data-reveal class="mt-16">
    <div class="photo">
      <Image
        src={studentsWorking}
        alt="Students working on laptops around a shared table"
        widths={[1200, 2000]}
        sizes="100vw"
        class="h-72 w-full object-cover md:h-[28rem]"
      />
    </div>
    <figcaption
      class={`mx-auto mt-3 max-w-6xl px-6 ${microLabel}`}
    >
      Where the work actually gets written
    </figcaption>
  </figure>
</section>
