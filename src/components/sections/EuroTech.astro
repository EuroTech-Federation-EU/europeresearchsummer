---
import { Image } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import logoLight from "../../assets/logo-light.png";
import { EUROTECH_SIGNALS } from "../../data/program";
---

<section id="eurotech" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div data-reveal>
        <SectionHead
          eyebrowText="Behind the programme"
          title="EuroTech Federation."
          lead="A pan-European deep-tech federation founded in April 2025."
        />
        <ul class="grid gap-4">
          {
            EUROTECH_SIGNALS.map((item) => (
              <li class="flex items-start gap-3.5 text-muted">
                <span
                  class="mt-1.5 size-1.5 shrink-0 bg-cyan"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div
        data-reveal
        style="--reveal-delay: 100ms"
        class="rounded-xs border border-line bg-card/60 px-10 py-14 text-center"
      >
        <a
          href="https://eurotech-federation.com"
          target="_blank"
          rel="noopener"
          aria-label="EuroTech Federation website"
          class="group mb-6 inline-block"
        >
          <Image
            src={logoLight}
            alt="EuroTech Federation logo"
            width={280}
            class="mx-auto h-28 w-auto transition-transform duration-200 ease-snap group-hover:scale-105"
          />
        </a>
        <h3 class="mb-2 text-lg font-semibold tracking-tight">
          Advised at the highest level.
        </h3>
        <p class="text-muted">
          Advised by a former President of the European Research Council, with
          65+ researchers connected in the jury network.
        </p>
      </div>
    </div>
  </div>
</section>
