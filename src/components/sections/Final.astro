---
import { Image } from "astro:assets";
import { FINAL_POINTS } from "../../data/program";
import { kicker } from "../../lib/styles";
import parisBridge from "../../assets/photos/paris-bridge.jpg";
import finalAudience from "../../assets/photos/final-audience.jpg";

const STAGGER_STEP_MS = 70;
---

<section id="final" class="overflow-hidden border-y border-line py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <p data-reveal class={kicker}>The final · Summer 2026</p>
    <h2
      data-reveal
      style={`--reveal-delay: ${STAGGER_STEP_MS}ms`}
      class="final-wordmark mt-6 text-[26vw] leading-none font-bold tracking-[-0.01em] uppercase select-none md:text-[12rem]"
      aria-label="Paris"
    >
      Paris
    </h2>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      <figure
        data-reveal
        class="overflow-hidden rounded-xs border border-line md:col-span-2"
      >
        <Image
          src={parisBridge}
          alt="Pont Alexandre III in Paris at dusk"
          widths={[800, 1600]}
          sizes="(max-width: 768px) 100vw, 736px"
          class="h-72 w-full object-cover saturate-[0.85] md:h-96"
        />
      </figure>
      <figure
        data-reveal
        style={`--reveal-delay: ${STAGGER_STEP_MS}ms`}
        class="overflow-hidden rounded-xs border border-line max-md:hidden"
      >
        <Image
          src={finalAudience}
          alt="Audience in a dark auditorium"
          widths={[600, 1200]}
          sizes="352px"
          class="h-96 w-full object-cover saturate-[0.85]"
        />
      </figure>
    </div>
    <div class="mt-10 grid gap-y-10 border-t border-line pt-10 md:grid-cols-3">
      {
        FINAL_POINTS.map((point, index) => (
          <div
            data-reveal
            style={`--reveal-delay: ${index * STAGGER_STEP_MS}ms`}
            class={`md:px-8 ${index > 0 ? "md:border-l md:border-line" : "md:pl-0"}`}
          >
            <h3 class="font-mono text-xs tracking-[0.2em] text-cyan uppercase">
              {point.title}
            </h3>
            <p class="mt-4 text-muted">{point.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Outlined display word: ink is the stroke, the ground shows through. */
  .final-wordmark {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--color-body);
  }

  @media (min-width: 768px) {
    .final-wordmark {
      -webkit-text-stroke-width: 2px;
    }
  }
</style>
