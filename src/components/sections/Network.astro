---
import { Image } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import LogoWall from "../ui/LogoWall.astro";
import {
  PARTICIPANT_AFFILIATIONS,
  PARTNER_LOGOS,
  REVIEWER_AFFILIATIONS,
  COMMUNITY_PARTNERS,
} from "../../data/network";
import { btnGhost } from "../../lib/styles";

// Some partner marks ship with a baked background, so each keeps the tile
// tone its file was drawn for, even on the paper ground.
const PARTNER_TILE_TONES = {
  light: "border border-line bg-white",
  dark: "bg-black",
  panel: "bg-card",
} as const;
---

<section id="network" class="on-paper py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div data-reveal>
      <SectionHead
        eyebrowText="The network"
        title="Backed across the European AI ecosystem."
        lead="Aggregate affiliations across the cohort and the jury, never linked to any individual paper."
      />
    </div>
    <div data-reveal class="mb-16 flex flex-wrap items-center gap-x-10 gap-y-6">
      <span class="font-mono text-label tracking-label text-muted uppercase">
        Supported by
      </span>
      {
        PARTNER_LOGOS.map((logo) => (
          <Image
            src={logo.src}
            alt={logo.alt}
            width={240}
            class="h-10 w-auto object-contain mix-blend-multiply"
          />
        ))
      }
      <a href="#contact" class={`${btnGhost} px-5! py-2.5! text-label`}>
        Become a partner
      </a>
    </div>
    <div class="grid gap-14">
      <div data-reveal>
        <LogoWall
          title="Participants are affiliated with"
          logos={PARTICIPANT_AFFILIATIONS}
        />
      </div>
      <div data-reveal>
        <LogoWall
          title="Reviewers are affiliated with"
          logos={REVIEWER_AFFILIATIONS}
        />
      </div>
      <div data-reveal>
        <h3 class="mb-6 font-mono text-label tracking-label text-muted uppercase">
          Community partners
        </h3>
        <ul class="flex flex-wrap items-start gap-3">
          {
            COMMUNITY_PARTNERS.map((partner) => (
              <li>
                <a
                  href={partner.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={partner.alt}
                  class="society-tile block rounded-xs active:scale-[0.97]"
                >
                  <span
                    class={`flex h-16 w-28 items-center justify-center rounded-xs p-3 ${PARTNER_TILE_TONES[partner.tone]}`}
                  >
                    <Image
                      src={partner.src}
                      alt=""
                      width={220}
                      class="max-h-10 w-auto max-w-full object-contain"
                    />
                  </span>
                  <span
                    class="mt-2.5 line-clamp-2 block w-28 text-center font-mono text-label tracking-label text-muted uppercase"
                    aria-hidden="true"
                  >
                    {partner.label}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .society-tile {
    transition: transform 150ms var(--ease-snap);
  }

  @media (hover: hover) and (pointer: fine) {
    .society-tile:hover {
      transform: translateY(-2px);
    }
  }
</style>
