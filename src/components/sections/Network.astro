---
import { Image } from "astro:assets";
import SectionHead from "../ui/SectionHead.astro";
import LogoWall from "../ui/LogoWall.astro";
import {
  PARTICIPANT_AFFILIATIONS,
  PARTNER_LOGOS,
  REVIEWER_AFFILIATIONS,
  SOCIETY_LOGOS,
} from "../../data/network";
import { btnGhost } from "../../lib/styles";

const SOCIETY_TILE_TONES = {
  light: "bg-white",
  dark: "bg-black",
  panel: "border border-line bg-card",
} as const;
---

<section id="network" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div data-reveal>
      <SectionHead
        eyebrowText="The network"
        title="Backed across the European AI ecosystem."
        lead="Aggregate affiliations across the cohort and the jury, never linked to any individual paper."
      />
    </div>
    <div data-reveal class="mb-16 flex flex-wrap items-center gap-x-8 gap-y-6">
      <span class="font-mono text-xs tracking-[0.2em] text-muted uppercase">
        Supported by
      </span>
      {
        PARTNER_LOGOS.map((logo) => (
          <div
            class="flex h-18 w-36 items-center justify-center rounded-xs bg-body/95 p-4"
            title={logo.alt}
          >
            <Image
              src={logo.src}
              alt={logo.alt}
              width={240}
              class="max-h-10 w-auto max-w-full mix-blend-multiply object-contain"
            />
          </div>
        ))
      }
      <a href="#contact" class={`${btnGhost} px-5! py-2.5! text-xs`}>
        Become a partner
      </a>
    </div>
    <div class="grid gap-14">
      <div data-reveal>
        <LogoWall
          title="Participants are affiliated with"
          logos={PARTICIPANT_AFFILIATIONS}
        />
      </div>
      <div data-reveal>
        <LogoWall
          title="Reviewers are affiliated with"
          logos={REVIEWER_AFFILIATIONS}
        />
      </div>
      <div data-reveal>
        <h3 class="mb-6 font-mono text-xs tracking-[0.2em] text-muted uppercase">
          University AI societies onboarded
        </h3>
        <div class="flex flex-wrap items-center gap-2.5">
          {
            SOCIETY_LOGOS.map((society) => (
              <a
                href={society.href}
                target="_blank"
                rel="noopener"
                aria-label={society.alt}
                class="group relative"
              >
                <span
                  class={`flex h-16 w-28 items-center justify-center rounded-xs p-3 transition-transform duration-200 ease-snap group-hover:scale-105 group-focus-visible:scale-105 ${SOCIETY_TILE_TONES[society.tone]}`}
                >
                  <Image
                    src={society.src}
                    alt=""
                    width={220}
                    class="max-h-10 w-auto max-w-full object-contain"
                  />
                </span>
                <span
                  class="pointer-events-none absolute -top-9 left-1/2 z-10 -translate-x-1/2 translate-y-1 rounded-xs border border-line bg-navy px-2.5 py-1.5 font-mono text-[10px] whitespace-nowrap tracking-[0.1em] text-body uppercase opacity-0 transition-[opacity,transform] duration-150 ease-snap group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
                  aria-hidden="true"
                >
                  {society.alt}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
