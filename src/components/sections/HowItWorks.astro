---
import SectionHead from "../ui/SectionHead.astro";
import { AREAS, STAGES } from "../../data/program";

const STAGGER_STEP_MS = 60;
---

<section id="how-it-works" class="py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <div data-reveal>
      <SectionHead
        eyebrowText="How it works"
        title="From your AI society to the Paris final."
      />
    </div>
    <ol>
      {
        STAGES.map((stage, index) => (
          <li
            data-reveal
            style={`--reveal-delay: ${index * STAGGER_STEP_MS}ms`}
            class="group grid gap-2 border-b border-line py-8 transition-[background-color] duration-200 ease-snap first:border-t hover:bg-body/3 md:grid-cols-[6rem_16rem_1fr] md:items-baseline md:gap-6"
          >
            <span class="font-mono text-2xl text-cyan tabular-nums">
              {stage.step}
            </span>
            <h3 class="text-2xl font-semibold tracking-tight uppercase">
              {stage.title}
            </h3>
            <p class="text-muted">{stage.text}</p>
          </li>
        ))
      }
    </ol>
    <div data-reveal class="mt-16">
      <h3 class="mb-6 font-mono text-xs tracking-[0.2em] text-muted uppercase">
        Research areas across the cohort
      </h3>
      <ul class="grid gap-x-12 sm:grid-cols-2">
        {
          AREAS.map((area) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-line py-4">
              <span class="font-semibold tracking-tight">{area.title}</span>
              <span class="text-right font-mono text-[11px] tracking-[0.08em] text-muted uppercase">
                {area.tag}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
