---
import GridLines from "../layout/GridLines.astro";
import { btnGhost, btnPrimary } from "../../lib/styles";

const STAGGER_STEP_MS = 70;
// Three words, each its own line, set so the longest lands on the column's
// right edge. The wordmark is the hero; nothing is centred under it.
const TITLE_WORDS = ["Europe", "Research", "Summer"] as const;
---

<section class="relative flex min-h-[calc(100svh-4rem)] flex-col">
  <GridLines />

  <div
    class="@container relative mx-auto flex w-full max-w-6xl flex-1 flex-col justify-center px-6 pt-6 pb-8"
  >
    <h1
      class="hero-wordmark leading-[0.8] font-bold tracking-display text-body uppercase"
    >
      {
        TITLE_WORDS.map((word, index) => (
          <span
            data-reveal
            style={`--reveal-delay: ${index * STAGGER_STEP_MS}ms`}
            class="block"
          >
            {word}
          </span>
        ))
      }
    </h1>
  </div>

  <div class="relative mx-auto w-full max-w-6xl px-6 pb-8">
    <div
      data-reveal
      style={`--reveal-delay: ${TITLE_WORDS.length * STAGGER_STEP_MS}ms`}
      class="grid gap-8 border-t border-line pt-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-16"
    >
      <p class="max-w-2xl text-lede text-balance text-body">
        You write the research. Working scientists review it blind. One of you presents in Paris.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="#how-it-works" class={btnPrimary}>How it works</a>
        <a href="#network" class={btnGhost}>Partner with us</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Sized so the longest word (RESEARCH) lands on the right edge of the
     content column at every width, which is what makes the stack read as a
     masthead rather than a big heading.

     Measured, not guessed: in Space Grotesk bold at `tracking-display`,
     RESEARCH is 4.674em wide, so the fitting size is 0.2140 x the column.
     Re-measure it if the face, the weight or the tracking ever changes.

     `cqw` measures the parent's content box (the `@container` on it), which
     is the column itself. `vw` would include the scrollbar and overflow by
     its width on any viewport below the cap. 99.3% of the column, not 100%,
     keeps subpixel rounding off the edge.

     The third term is a height guard: three lines at this leading are 2.4x
     the font size, so on a short viewport the width-fitting size would push
     the lede and the actions off screen. It stays out of the way down to
     about 830px of viewport height; below that the wordmark gives up a
     little of the right edge rather than the reader giving up the call to
     action. */
  .hero-wordmark {
    font-size: min(21.25cqw, 14.66rem, 27svh);
  }
</style>
