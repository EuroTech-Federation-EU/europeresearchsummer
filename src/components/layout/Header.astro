---
import { Image } from "astro:assets";
import logoLight from "../../assets/logo-light.png";
import { NAV_LINKS } from "../../data/site";
---

<header
  class="sticky top-0 z-50 border-b border-line bg-navy/80 backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/#top" class="flex items-center gap-3">
      <Image src={logoLight} alt="EuroTech Federation logo" class="size-9" width={72} />
      <span class="font-semibold tracking-tight">
        Europe Research Summer
        <small
          class="block font-mono text-[10px] font-medium tracking-[0.18em] text-muted uppercase"
        >
          by EuroTech Federation
        </small>
      </span>
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="font-mono text-xs tracking-[0.15em] text-muted uppercase transition-colors duration-150 hover:text-body"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/#contact"
        class="rounded-xs bg-body px-4 py-2.5 font-mono text-xs font-semibold tracking-[0.15em] text-navy uppercase transition-[transform,background-color] duration-150 ease-snap hover:bg-white active:scale-[0.97]"
      >
        Get involved
      </a>
    </nav>
    <button
      id="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      class="flex size-11 items-center justify-center rounded-xs text-body transition-[transform,background-color] duration-150 ease-snap hover:bg-body/10 active:scale-[0.94] md:hidden"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <path class="menu-icon-open" d="M4 7h16M4 12h16M4 17h16" />
        <path class="menu-icon-close hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
  <nav
    id="mobile-menu"
    aria-label="Main"
    class="hidden border-t border-line bg-navy/95 px-6 py-4 backdrop-blur-xl md:hidden!"
  >
    {
      NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="block rounded-xs px-2 py-3 font-mono text-sm tracking-[0.15em] text-body uppercase transition-colors duration-150 hover:bg-body/5"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="/#contact"
      class="mt-3 block rounded-xs bg-body px-5 py-3 text-center font-mono text-sm font-semibold tracking-[0.15em] text-navy uppercase active:scale-[0.98]"
    >
      Get involved
    </a>
  </nav>
</header>

<script>
  const button = document.getElementById("menu-button");
  const menu = document.getElementById("mobile-menu");

  function setMenu(isOpen: boolean) {
    if (!button || !menu) return;
    button.setAttribute("aria-expanded", String(isOpen));
    button.setAttribute("aria-label", isOpen ? "Close menu" : "Open menu");
    menu.classList.toggle("hidden", !isOpen);
    button.querySelector(".menu-icon-open")?.classList.toggle("hidden", isOpen);
    button
      .querySelector(".menu-icon-close")
      ?.classList.toggle("hidden", !isOpen);
  }

  button?.addEventListener("click", () => {
    setMenu(button.getAttribute("aria-expanded") !== "true");
  });
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
</script>
