---
// Discreet bottom-anchored notice about cookieless analytics. Informational
// only: Vercel Web Analytics sets no cookies and stores no personal data,
// so no consent gate is required. Dismissal persists in localStorage.
---

<aside
  id="privacy-notice"
  role="status"
  class="privacy-notice fixed bottom-4 left-4 z-50 hidden max-w-[15rem] translate-y-2 items-center gap-1 rounded-xs border border-line bg-navy/85 py-1 pr-1 pl-3 opacity-0 backdrop-blur-xl data-shown:translate-y-0 data-shown:opacity-100"
>
  <p class="font-mono text-label tracking-label text-muted uppercase">
    No cookies <a
      href="/legal"
      class="-my-3 inline-block py-3 text-cyan hover:underline">Details</a
    >
  </p>
  <button
    id="privacy-notice-ok"
    type="button"
    aria-label="Dismiss notice"
    class="-m-1.5 flex size-11 shrink-0 items-center justify-center rounded-xs text-muted transition-[transform,background-color,color] duration-150 ease-snap hover:bg-body/10 hover:text-body active:scale-[0.94]"
  >
    <svg
      viewBox="0 0 24 24"
      class="size-3.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M6 6l12 12M18 6L6 18"></path>
    </svg>
  </button>
</aside>

<style>
  /* Least important thing on the page, so it gets the lightest material:
     a translucent hairline strip, not a shadowed card with a primary button.
     Enter is deliberate, exit is snappy. */
  .privacy-notice {
    display: flex;
    transition:
      opacity 150ms var(--ease-snap),
      transform 150ms var(--ease-snap);
  }

  /* The script toggles `hidden` to keep the element out of the flow until it
     is due; it must win over the display above. */
  .privacy-notice.hidden {
    display: none;
  }

  .privacy-notice[data-shown] {
    transition-duration: 300ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .privacy-notice {
      transform: none;
      transition: opacity 150ms ease;
    }
  }
</style>

<script>
  const STORAGE_KEY = "privacy-notice-dismissed";
  const SHOW_DELAY_MS = 1200;
  const notice = document.getElementById("privacy-notice");
  const okButton = document.getElementById("privacy-notice-ok");

  let isDismissed = false;
  try {
    isDismissed = localStorage.getItem(STORAGE_KEY) === "1";
  } catch {
    // Storage unavailable (private mode): show the notice each visit.
  }

  // Informational notice, no consent required, so it must never sit on top
  // of the hero's call-to-action row. Wait for that row to leave the
  // viewport before revealing (still gated by the same show delay).
  const heroCta = document.querySelector('a[href="#network"]');

  function reveal() {
    if (!notice) return;
    notice.classList.remove("hidden");
    requestAnimationFrame(() => {
      notice.dataset.shown = "";
    });
  }

  function revealWhenHeroCtaClear() {
    if (!heroCta || typeof IntersectionObserver === "undefined") {
      reveal();
      return;
    }
    const rect = heroCta.getBoundingClientRect();
    const isInViewport = rect.bottom > 0 && rect.top < window.innerHeight;
    if (!isInViewport) {
      reveal();
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      const entry = entries[0];
      if (entry && !entry.isIntersecting) {
        observer.disconnect();
        reveal();
      }
    });
    observer.observe(heroCta);
  }

  if (notice && !isDismissed) {
    setTimeout(revealWhenHeroCtaClear, SHOW_DELAY_MS);
  }

  okButton?.addEventListener("click", () => {
    try {
      localStorage.setItem(STORAGE_KEY, "1");
    } catch {
      // Best effort only; the notice simply reappears next visit.
    }
    if (notice) {
      delete notice.dataset.shown;
      setTimeout(() => notice.classList.add("hidden"), 300);
    }
  });
</script>
