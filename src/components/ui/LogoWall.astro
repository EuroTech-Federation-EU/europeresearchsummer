---
import { Image } from "astro:assets";
import type { Logo } from "../../data/network";

interface Props {
  title: string;
  logos: Logo[];
}

const { title, logos } = Astro.props;
---

<div>
  <h3 class="mb-6 font-mono text-label tracking-label text-muted uppercase">
    {title}
  </h3>
  <ul class="grid grid-cols-2 border-t border-l border-line sm:grid-cols-3 md:grid-cols-5">
    {
      logos.map((logo) => (
        <li class="logo-cell border-r border-b border-line">
          <div class="flex h-full min-h-32 flex-col items-center justify-center gap-3 px-4 py-5">
            <Image
              src={logo.src}
              alt=""
              width={160}
              class="logo-mark h-11 w-auto max-w-full object-contain"
            />
            <span class="text-center font-mono text-label tracking-label text-muted uppercase">
              {logo.alt}
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* Index, not a chip cloud: every mark sits in its own cell of a hairline
     grid, named underneath. Desaturated at rest so the wall reads as one
     texture; colour is the hover reward. */
  .logo-mark {
    filter: grayscale(1);
    opacity: 0.85;
    transition:
      filter 150ms var(--ease-snap),
      opacity 150ms var(--ease-snap);
  }

  .logo-cell {
    transition: background-color 150ms var(--ease-snap);
  }

  /* Touch devices fire hover on tap, so the reward is pointer-only. */
  @media (hover: hover) and (pointer: fine) {
    .logo-cell:hover {
      background-color: var(--color-tint);
    }

    .logo-cell:hover .logo-mark {
      filter: grayscale(0);
      opacity: 1;
    }
  }
</style>
