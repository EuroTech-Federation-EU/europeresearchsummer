---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import PrivacyNotice from "../components/layout/PrivacyNotice.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Europe Research Summer · EuroTech Federation",
  description = "Europe Research Summer by EuroTech Federation: a pan-European AI research programme. Students submit original AI/ML research through their university AI societies; papers go through double-blind review and national winners present at a global final in Paris.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og.png", Astro.site);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "EuroTech Federation",
      url: "https://eurotech-federation.com",
      description:
        "A pan-European deep-tech federation founded in April 2025, behind the Europe Research Summer programme.",
    },
    {
      "@type": "WebSite",
      name: "Europe Research Summer",
      url: Astro.site?.toString(),
      description,
      publisher: { "@type": "Organization", name: "EuroTech Federation" },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-mono-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Europe Research Summer" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0F172A" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script>
      // Gate reveal hidden-states behind JS availability, before first paint.
      document.documentElement.classList.add("js");

      // This class hides every revealable element until the observer below
      // reveals it, so a reveal script that never runs would leave the page
      // blank. If it has not signalled readiness shortly after load, drop the
      // gate: no entrance animation is a far better failure than no content.
      const REVEAL_SCRIPT_TIMEOUT_MS = 2500;
      window.setTimeout(() => {
        // Presence, not value: the flag is set to an empty string, which is
        // falsy, so testing the value would fire the fallback every time.
        if (!document.documentElement.hasAttribute("data-reveal-ready")) {
          document.documentElement.classList.remove("js");
        }
      }, REVEAL_SCRIPT_TIMEOUT_MS);
    </script>
  </head>
  <body class="bg-navy font-sans text-body antialiased">
    <Header />
    <slot />
    <Footer />
    <PrivacyNotice />
    {
      import.meta.env.PROD && (
        <script defer src="/_vercel/insights/script.js" is:inline />
      )
    }
    <script>
      // Tells the head's safety timeout that the reveal path is alive.
      document.documentElement.dataset.revealReady = "";

      const revealed = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-inview");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -60px 0px" },
      );
      revealed.forEach((element) => observer.observe(element));
    </script>
  </body>
</html>
